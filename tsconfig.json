{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "composite": true,
    "paths": {
      "@opencode/engine": ["./packages/engine/src"],
      "@opencode/engine/*": ["./packages/engine/src/*"],
      "@opencode/flow-runtime": ["./packages/flow-runtime/src"],
      "@opencode/flow-runtime/*": ["./packages/flow-runtime/src/*"],
      "@opencode/flow-sdk": ["./packages/flow-sdk/src"],
      "@opencode/flow-sdk/*": ["./packages/flow-sdk/src/*"],
      "@opencode/flow-ai-compiler": ["./packages/flow-ai-compiler/src"],
      "@opencode/flow-ai-compiler/*": ["./packages/flow-ai-compiler/src/*"]
    }
  },
  "include": [],
  "references": [
    { "path": "packages/engine" },
    { "path": "packages/flow-runtime" },
    { "path": "packages/flow-sdk" },
    { "path": "packages/flow-ai-compiler" }
  ],
  "exclude": ["node_modules", "dist", "packages/*/dist"]
}
