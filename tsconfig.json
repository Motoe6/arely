{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "composite": true,
    "paths": {
      "@arelyos/llm-core": ["./packages/llm-core/src"],
      "@arelyos/llm-core/*": ["./packages/llm-core/src/*"],
      "@arelyos/persistence": ["./packages/persistence/src"],
      "@arelyos/persistence/*": ["./packages/persistence/src/*"],
      "@arelyos/memory": ["./packages/memory/src"],
      "@arelyos/memory/*": ["./packages/memory/src/*"],
      "@arelyos/agent-core": ["./packages/agent-core/src"],
      "@arelyos/agent-core/*": ["./packages/agent-core/src/*"],
      "@arelyos/evolution": ["./packages/evolution/src"],
      "@arelyos/evolution/*": ["./packages/evolution/src/*"],
      "@arelyos/sdk": ["./packages/sdk/src"],
      "@arelyos/sdk/*": ["./packages/sdk/src/*"],
      "@arelyos/plugins": ["./packages/plugins/src"],
      "@arelyos/plugins/*": ["./packages/plugins/src/*"],
      "@arelyos/engine": ["./packages/engine/src"],
      "@arelyos/engine/*": ["./packages/engine/src/*"],
      "@arelyos/flow-runtime": ["./packages/flow-runtime/src"],
      "@arelyos/flow-runtime/*": ["./packages/flow-runtime/src/*"],
      "@arelyos/flow-sdk": ["./packages/flow-sdk/src"],
      "@arelyos/flow-sdk/*": ["./packages/flow-sdk/src/*"],
      "@arelyos/flow-ai-compiler": ["./packages/flow-ai-compiler/src"],
      "@arelyos/flow-ai-compiler/*": ["./packages/flow-ai-compiler/src/*"],
      "@arelyos/benchmarks": ["./packages/benchmarks/src"],
      "@arelyos/benchmarks/*": ["./packages/benchmarks/src/*"],
      "@arelyos/ui-core": ["./packages/ui-core/src"],
      "@arelyos/ui-core/*": ["./packages/ui-core/src/*"],
      "@arelyos/cli": ["./packages/cli/src"],
      "@arelyos/cli/*": ["./packages/cli/src/*"]
    }
  },
  "include": [],
  "references": [
    { "path": "packages/llm-core" },
    { "path": "packages/persistence" },
    { "path": "packages/memory" },
    { "path": "packages/agent-core" },
    { "path": "packages/evolution" },
    { "path": "packages/plugins" },
    { "path": "packages/sdk" },
    { "path": "packages/engine" },
    { "path": "packages/flow-runtime" },
    { "path": "packages/flow-sdk" },
    { "path": "packages/flow-ai-compiler" },
    { "path": "packages/benchmarks" },
    { "path": "packages/ui-core" },
    { "path": "packages/cli" }
  ],
  "exclude": ["node_modules", "dist", "packages/*/dist"]
}
