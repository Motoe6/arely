# LLM Provider
OPENCODE_API_KEY=sk-your-key-here
OPENCODE_BASE_URL=https://api.openai.com/v1
OPENCODE_MODEL=gpt-4o

# Search Providers (optional)
EXA_API_KEY=
PARALLEL_API_KEY=
OPENCODE_WEBSEARCH_PROVIDER=exa

# Permissions
OPENCODE_PERMIT_WEBSEARCH=ask
OPENCODE_PERMIT_WEBFETCH=ask

# Server
PORT=8081
DB_PATH=./data/opencode.db

# Logging
LOG_LEVEL=info
