# LLM Provider
# (OPENCODE_* vars are deprecated — use ARELY_* instead)
ARELY_API_KEY=sk-your-key-here
ARELY_BASE_URL=https://api.openai.com/v1
ARELY_MODEL=gpt-4o

# Search Providers (optional)
EXA_API_KEY=
PARALLEL_API_KEY=
ARELY_WEBSEARCH_PROVIDER=exa

# Permissions
ARELY_PERMIT_WEBSEARCH=ask
ARELY_PERMIT_WEBFETCH=ask

# Server
PORT=8081
DB_PATH=./data/arely.db

# Logging
LOG_LEVEL=info

# Model Registry
# Override default models (JSON array of ModelDefinition). Omit for 3 defaults (deepseek-v4, mimo-v2, nemotron-ultra).
# ARELY_MODELS=[{"id":"custom","name":"Custom Model","provider":"openrouter","model":"some/model:id","baseUrl":"https://openrouter.ai/api/v1","capabilities":["chat","tools"],"contextWindow":128000,"costTier":"free","enabled":true}]
ARELY_DEFAULT_MODEL=deepseek-v4
